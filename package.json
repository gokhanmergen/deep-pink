{
  "name": "deep-pink",
  "version": "0.14.0",
  "description": "Deep Pink — a local-first, open-source desktop AI chat app for OpenRouter",
  "main": "./out/main/index.js",
  "desktopName": "dev.deeppink.app.desktop",
  "author": "gokhanmergen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gokhanmergen/deep-pink.git"
  },
  "scripts": {
    "dev": "pnpm run tauri:dev",
    "start": "pnpm run tauri:dev",
    "build": "pnpm run typecheck && tauri build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node scripts/run-tests.mjs",
    "dev:electron": "electron-vite dev",
    "start:electron": "electron-vite preview",
    "build:electron": "pnpm run typecheck && electron-vite build",
    "tauri:frontend:dev": "vite --config vite.tauri.config.ts",
    "tauri:prepare": "node scripts/build-tauri-backend.mjs && vite build --config vite.tauri.config.ts",
    "tauri:dev": "node scripts/build-tauri-backend.mjs && tauri dev",
    "tauri:build": "tauri build",
    "dist:linux": "pnpm run typecheck && tauri build --bundles appimage,deb,rpm",
    "dist:mac": "pnpm run typecheck && tauri build --bundles dmg",
    "dist:windows": "pnpm run typecheck && tauri build --bundles nsis",
    "dist:linux:electron": "pnpm run build:electron && electron-builder --linux",
    "dist:mac:electron": "pnpm run build:electron && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^13.0.1",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@lobehub/icons-static-svg": "^1.95.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^4.0.0",
    "esbuild": "^0.28.1",
    "katex": "^0.16.22",
    "lucide-react": "^1.32.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^3.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "zustand": "^5.0.14"
  },
  "packageManager": "pnpm@11.17.0"
}
