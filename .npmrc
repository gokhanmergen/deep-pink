# electron-builder resolves the dependency tree on disk when it packages the
# app, and cannot follow pnpm's default symlinked layout. A hoisted store gives
# it a plain node_modules to walk, which is what makes the native SQLite
# binding survive packaging.
node-linker=hoisted

# better-sqlite3 and electron run install scripts to fetch or build their
# binaries. Without this pnpm skips them and the app has no database.
enable-pre-post-scripts=true
